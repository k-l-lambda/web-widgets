{
  "name": "@k-l-lambda/music-widgets",
  "version": "1.0.1",
  "description": "A package contains some music utility modules.",
  "keywords": [
    "midi",
    "svg"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "browser": "dist/musicWidgetsBrowser.umd.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^14.0.27",
    "@vue/cli-plugin-babel": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "@vue/compiler-sfc": "^3.4.0",
    "lodash": "^4.17.21",
    "ts-node-dev": "^1.0.0-pre.56",
    "typescript": "^3.9.7",
    "vue": "^3.4.0"
  },
  "scripts": {
    "build": "tsc && cp -r source/MidiAudio lib/ && vue-cli-service build --target lib --name musicWidgetsBrowser index.browser.js",
