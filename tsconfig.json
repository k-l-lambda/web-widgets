{
	"compilerOptions": {
		"moduleResolution": "node",
		"downlevelIteration": true,
		"lib": ["es2017", "dom"],
		"target": "es6",
		"module": "commonjs",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"declaration": true,
		"outDir": "lib",
		"allowJs": true,
		"skipLibCheck": true,
		"noEmitOnError": false,
		"types": ["node"]
	},
	"include": [
		"source/inc/**/*.ts",
		"source/inc/**/*.js",
		"index.ts"
	]
}
